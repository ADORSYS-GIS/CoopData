FROM node:22-alpine

WORKDIR /app

# Dependencies are installed at container start (so node_modules stays cached
# in the image layer). The bind-mounted source provides live updates.
COPY package.json package-lock.json ./
RUN npm install

# Source files are bind-mounted at runtime for HMR.
EXPOSE 5173

CMD ["npx", "vite", "--host", "0.0.0.0", "--port", "5173"]