# ===========================================
# CoopData Backend Configuration
# ===========================================
# Copy this file to .env and adjust values.
# For local development with docker-compose, the defaults below work as-is.
# For production, change ALL secrets.

# Server
HOST=0.0.0.0
PORT=3000

# Database
# Local dev default matches docker-compose: user=coopdata, password=password
DATABASE_URL=postgresql://coopdata:password@localhost:5432/coopdata

# Redis
REDIS_URL=redis://localhost:6379

# Keycloak (OpenID Connect)
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=coop-data
KEYCLOAK_CLIENT_ID=coopdata-backend
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# JWT Validation
JWT_ISSUER=http://localhost:8180/realms/coop-data
# When running backend in Docker, the token issuer seen by the browser is localhost
# but the backend's internal Keycloak URL is the Docker hostname. List aliases here.
JWT_ISSUER_ALIASES=http://keycloak:8180/realms/coop-data
JWT_AUDIENCE=coopdata-frontend

# CORS — allowed frontend origin
FRONTEND_URL=http://localhost:5173
GOTENBERG_URL=http://localhost:8081
GOTENBERG_FRONTEND_URL=http://localhost:5173

# Environment: development | staging | production
ENVIRONMENT=development

# ── Object Storage ────────────────────────────────────────────────────────────
# STORAGE_BACKEND: "local" (default, stores in ./data/uploads) | "s3" (MinIO/S3)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads

# Uncomment for S3/MinIO (production):
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=coopdata-uploads
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1

# ── AI Extraction Pipeline ────────────────────────────────────────────────────
# EXTRACTION_BACKEND: "mock" (default, deterministic) | "llm" (real API)
EXTRACTION_BACKEND=mock

# Uncomment and set to enable real LLM extraction:
# AI_PROVIDER_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o
# AI_VISION_MODEL=gpt-4othis is 