# CoopData AI Module — configuration
# Copy to .env and adjust before deploying.

# Model to serve (HuggingFace id)
AI_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# Name exposed to the app via /v1 (keep stable so the app's AI_MODEL doesn't change)
AI_SERVED_NAME=qwen2.5vl:7b

# Context length (tokens) — caps KV cache
AI_MAX_MODEL_LEN=32768

# Concurrency — how many requests processed in parallel
AI_MAX_NUM_SEQS=8

# GPU memory utilization (0.0–1.0)
AI_GPU_UTIL=0.9

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=change-me
