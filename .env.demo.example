# =============================================================================
# CoopData Demo / Staging Environment Configuration (.env.demo)
# =============================================================================
# Copy this file to .env.demo on your server.
#
# Dedicated Demo Environment variables:
#   - Isolated DB Name: coopdata_demo
#   - Isolated Domain: demo.coopdata.dgrvcoop360.com
#   - Resource cap: 25% of server total
# =============================================================================

# Database Secrets
POSTGRES_USER=coopdata
POSTGRES_PASSWORD=demo_postgres_password_123
POSTGRES_DB=coopdata_demo

# Object Storage Secrets (MinIO / S3)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=coopdata-demo

# Keycloak IAM Secrets
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=demo_admin_password_123
KEYCLOAK_CLIENT_SECRET=demo_client_secret_123

# Domain Settings (Demo Subdomain)
DOMAIN_NAME=coopdata.dgrvcoop360.com
FRONTEND_URL=https://demo.coopdata.dgrvcoop360.com
JWT_ISSUER=https://demo.coopdata.dgrvcoop360.com/auth/realms/coop-data
JWT_ISSUER_ALIASES=https://demo.coopdata.dgrvcoop360.com/auth/realms/coop-data,http://demo-keycloak:8180/realms/coop-data
ENVIRONMENT=demo
