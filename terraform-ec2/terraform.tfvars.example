aws_region       = "eu-central-1"
environment      = "prod"
instance_type    = "t3.xlarge"
root_volume_size = 50
# WARNING: Restrict this to your office/VPN or GitHub runner egress CIDRs for production.
allowed_ssh_cidr = "0.0.0.0/0"
# Public SSH key only — generate the private key OUTSIDE Terraform:
#   ssh-keygen -t ed25519 -f ~/.ssh/coopdata-prod -C "coopdata-prod"
#   cat ~/.ssh/coopdata-prod.pub
ssh_public_key   = "ssh-ed25519 AAAA... your-public-key"
