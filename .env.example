# ===========================================
# CoopData Environment Configuration
# ===========================================
# Copy this file to .env and adjust values.
# NEVER commit .env to version control.
# For production, generate strong random values for all secrets.

# ===========================================
# Database
# ===========================================
POSTGRES_USER=coopdata
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=coopdata
DATABASE_URL=postgresql://coopdata:change-me-in-production@postgres:5432/coopdata

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://redis:6379

# ===========================================
# Keycloak (OpenID Connect)
# ===========================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-in-production
KEYCLOAK_URL=http://keycloak:8180
KEYCLOAK_REALM=coop-data
KEYCLOAK_CLIENT_ID=coopdata-backend
KEYCLOAK_CLIENT_SECRET=change-me-in-production
# Public URL Keycloak uses when generating links in emails (verification, invitations).
# Must be reachable from the browser — use localhost for local dev, real domain for prod.


# ===========================================
# Backend
# ===========================================
HOST=0.0.0.0
PORT=3000
JWT_ISSUER=http://keycloak:8180/realms/coop-data
# Aliases allow tokens issued via the public URL (browser) to be accepted by the backend (Docker internal)
JWT_ISSUER_ALIASES=http://localhost:8180/realms/coop-data,https://ec2-63-184-67-85.eu-central-1.compute.amazonaws.com/realms/coop-data,https://ec2-63-184-67-85.eu-central-1.compute.amazonaws.com/auth/realms/coop-data,http://keycloak:8180/realms/coop-data
JWT_AUDIENCE=coopdata-frontend
FRONTEND_URL=http://localhost:5173
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_FRONTEND_URL=http://frontend:80
ENVIRONMENT=development

# ===========================================
# SMTP (email delivery for Keycloak)
# ===========================================
# Used by Keycloak for invitation/verification emails. For dev with MailHog, set:
#   SMTP_HOST=mailhog  SMTP_PORT=1025  SMTP_STARTTLS=false
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords).
# Never commit real secrets — keep them in your .env (gitignored).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_AUTH=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_DISPLAY=CoopData
SMTP_REPLY_TO=your-email@gmail.com
SMTP_ENVELOPE_FROM=your-email@gmail.com
# ===========================================
# Storage (MinIO / S3)
# ===========================================
STORAGE_TYPE=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=coopdata
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ===========================================
# AI Extraction
# ===========================================
EXTRACTION_BACKEND=mock

# ===========================================
# Domain (used by Keycloak KC_HOSTNAME in production)
# ===========================================
DOMAIN_NAME=coopdata.example.com

# ===========================================
# Alerting & Monitoring Webhooks (Slack / Discord)
# ===========================================
# Grafana Alerting & Autoheal send instant notifications when any container crashes or degrades.
SLACK_WEBHOOK_URL=https://hooks.slack.example.com/services/YOUR_SLACK_WEBHOOK_SECRET
DISCORD_WEBHOOK_URL=https://discord.example.com/api/webhooks/YOUR_DISCORD_WEBHOOK_SECRET
SLACK_CHANNEL=#alerts
AUTOHEAL_WEBHOOK_URL=https://hooks.slack.example.com/services/YOUR_SLACK_WEBHOOK_SECRET
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

# ===========================================
# Frontend Build Args (only used when building, not with pre-built GHCR images)
# ===========================================
VITE_API_BASE_URL=http://localhost:3000
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=coop-data
VITE_KEYCLOAK_CLIENT_ID=coopdata-frontend

# ===========================================
# Keycloak Provisioning — Admin Users
# ===========================================

# DGRV Super Admin (platform owner, full access)
COOPDATA_DGRV_ADMIN_EMAIL=admin@dgrv.coop
COOPDATA_DGRV_ADMIN_PASSWORD=Dgrv@Admin2026!
COOPDATA_DGRV_ADMIN_FIRSTNAME=DGRV
COOPDATA_DGRV_ADMIN_LASTNAME=Administrator

# Ministry Admin (national oversight user)
COOPDATA_MINISTRY_ADMIN_EMAIL=admin@ministry.gov
COOPDATA_MINISTRY_ADMIN_PASSWORD=Ministry@Admin2026!
COOPDATA_MINISTRY_ADMIN_FIRSTNAME=Ministry
COOPDATA_MINISTRY_ADMIN_LASTNAME=Administrator


# ── Monitoring (Observability Stack) ────────────────────────────────────────
# WARNING: Change this password in production!
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION_DAYS=30

# ===========================================
# Offsite Database Backups
# ===========================================
# Used by scripts/backup-postgres.sh (run nightly via cron).
# Set BACKUP_S3_ENDPOINT to your MinIO URL for local S3, or leave blank for AWS S3.
#
# AWS S3 example:
#   BACKUP_S3_BUCKET=coopdata-backups
#   BACKUP_S3_ENDPOINT=              (leave blank)
#   AWS_ACCESS_KEY_ID=AKIA...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_DEFAULT_REGION=us-east-1
#
# MinIO (offsite MinIO instance) example:
#   BACKUP_S3_BUCKET=coopdata-backups
#   BACKUP_S3_ENDPOINT=https://minio.yourserver.com
#   AWS_ACCESS_KEY_ID=minioadmin
#   AWS_SECRET_ACCESS_KEY=minioadmin
#
BACKUP_S3_BUCKET=coopdata-backups
BACKUP_S3_PREFIX=postgres
BACKUP_S3_ENDPOINT=
BACKUP_RETENTION_DAYS=30
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ===========================================
# k6 Load Testing
# ===========================================
# Used by k6 tests when running against production (K6_TARGET_ENV=production).
# Leave blank for localhost tests (uses local dev values automatically).
K6_TARGET_ENV=production
K6_BASE_URL=
K6_KEYCLOAK_URL=
K6_CLIENT_SECRET=your-production-keycloak-client-secret-here